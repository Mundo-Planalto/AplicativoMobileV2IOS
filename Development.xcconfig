//
//  Development.xcconfig
//  Mundo planalto Portal App
//
//  Configuração Debug. Enquanto a homologação (api.portal.mundoplanalto.com.br)
//  não está no ar, o desenvolvimento usa a base de produção (autorizado em 29/09/2026).
//  Quando a homologação subir, troque para a linha comentada abaixo.
//  Em xcconfig "//" inicia comentário, por isso a URL usa "$()" no meio das barras.
//

API_BASE_URL = https:/$()/portal.mundoplanalto.com.br/api/
// API_BASE_URL = https:/$()/api.portal.mundoplanalto.com.br/api/
